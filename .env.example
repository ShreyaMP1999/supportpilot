# Optional: enables Claude-drafted replies. Without it SupportPilot uses the offline extractive drafter.
ANTHROPIC_API_KEY=

SP_LLM_MODEL=claude-opus-5
SP_LLM_EFFORT=low            # low | medium | high — replies are short, low keeps latency/cost down
SP_USE_LLM=true
SP_USE_DENSE=true            # false = BM25-only retrieval (no torch model download)
SP_CONFIDENCE_THRESHOLD=0.4  # below this, tickets are escalated to a human
SP_TOP_K=3
SP_RETRIEVAL_INTENT_WEIGHT=0.6 # blend of KB-similarity evidence into the intent decision
SP_RETRIEVAL_TEMPERATURE=0.1
SP_BM25_WEIGHT=0.0           # weight of BM25 vs dense in rank fusion (0 = dense only; BM25 is the fallback)
SP_PRIOR_WEIGHT=0.5          # weight of the intent-classifier prior in article ranking
